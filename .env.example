# Copy to .env.local. With DEV_BYPASS=true the app runs entirely on sample data,
# so nothing below needs a real value. Set it to false to use real services.
#
# DEV_BYPASS turns off all authentication. It only works under `next dev`, and
# the app refuses to build or start in production with it on.
DEV_BYPASS=true

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Resend. EMAIL_FROM must be on a domain verified in your Resend account.
RESEND_API_KEY=
EMAIL_FROM="kori/os <noreply@your-domain.co.nz>"

# GoCardless. Leave GOCARDLESS_ENVIRONMENT as sandbox until the billing loop has
# been tested end to end; only the exact value "live" moves real money.
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_CLIENT_ID=
GOCARDLESS_CLIENT_SECRET=
GOCARDLESS_WEBHOOK_SECRET=
